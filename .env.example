# Copy this file to .env, then fill in your own values from
# Supabase -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Your WhatsApp number that the in-app help button messages.
# Digits only, country code first, no + or spaces (e.g. 256748993044).
VITE_ADMIN_WHATSAPP=256748993044
